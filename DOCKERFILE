# SET WORKING DIRECTORY INSIDE CONTAINER TO "APP"
WORKDIR "/APP"

# COPY REQUIREMENTS FILE AND INSTALL DEPENDENCIES
COPY requirements.txt .

# CREATE A VIRTUAL ENVIRONMENT NAMED "VENV" INSIDE THE "APP" DIRECTORY
RUN python -m venv "/APP/VENV"

# FIX: INSTALL PIP FIRST IN VIRTUAL ENVIRONMENT
RUN "/APP/VENV/bin/python" -m ensurepip --upgrade

# INSTALL DEPENDENCIES WITHIN THE VIRTUAL ENVIRONMENT
RUN "/APP/VENV/bin/pip" install --no-cache-dir -r requirements.txt

# COPY THE REST OF YOUR BACKEND CODE INTO THE CONTAINER
COPY . .

# SET ENVIRONMENT VARIABLES (OPTIONAL BUT USEFUL)
ENV PYTHONUNBUFFERED=1

# SET WORKING DIRECTORY TO THE "API" DIRECTORY
WORKDIR "/APP/API"

# EXPOSE THE PORT USED BY FASTAPI (LEAVING IT AT 8000 AS THE STANDARD)
EXPOSE 8000

# RUN THE API USING UVICORN FROM THE VIRTUAL ENVIRONMENT (UPDATE HOST AND PORT)
CMD ["/APP/VENV/bin/uvicorn", "MAIN:app", "--host", "0.0.0.0", "--port", "8000"]