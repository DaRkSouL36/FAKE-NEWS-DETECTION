# IGNORE VIRTUAL ENVIRONMENT DIRECTORY
VENV/

# IGNORE DATA FOLDER
DATA/

# IGNORE SAVED MODEL FOLDER 
MODEL/

# IGNORE EXPORTED FILES (E.G., MODEL EXPORTS, DATA EXPORTS, ETC.)
EXPORTS/

# IGNORE BACKGROUND VIDEO FILES AND RELATED ASSETS
BACKGROUND/

# IGNORE PYTHON BYTECODE FILES THAT ARE AUTOMATICALLY GENERATED
*.pyc
*.pyo
__pycache__/

# IGNORE IDE CONFIGURATION FILES
.vscode/    # VSCODE CONFIGURATION FOLDER
.idea/      # INTELLIJ IDEA CONFIGURATION FOLDER

# IGNORE LOG FILES THAT MAY BE GENERATED DURING EXECUTION
*.log

# IGNORE TEMPORARY FILES CREATED BY OPERATING SYSTEM OR EDITORS
*~           # TEMPROARY FILES (COMMONLY GENERATED ON UNIX-LIKE SYSTEMS)
.DS_Store    # GENERATED BY MACOS TO STORE DIRECTORY ATTRIBUTES
Thumbs.db    # GENERATED BY WINDOWS EXPLORER TO STORE THUMBNAIL CACHES

# IGNORE BUILD FILES THAT ARE GENERATED FROM SOURCE CODE
*.egg
*.dist-info/  # DIST INFO FOLDER GENERATED BY PYTHON PACKAGE INSTALLERS
*.whl         # WHEEL FILES (FOR PACKAGED DISTRIBUTIONS)

# IGNORE TEST AND COVERAGE FILES GENERATED DURING TESTING
.coverage       # COVERAGE REPORT FILE
nosetests.xml   # GENERATED BY NOSE TESTING FRAMEWORK
pytest.xml      # GENERATED BY PYTEST FRAMEWORK
tox.ini         # TOX CONFIGURATION FILE