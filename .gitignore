# IGNORE VIRTUAL ENVIRONMENT DIRECTORY
VENV/

# IGNORE DATA FOLDER
DATA/

# IGNORE SAVED MODEL FOLDER 
MODEL/

# IGNORE EXPORTED FILES (MODEL OUTPUTS SUCH AS METRICS AND PREDICTIONS)
EXPORTS/

# IGNORE BACKGROUND VIDEO FILES AND RELATED MEDIA ASSETS
BACKGROUND/

# IGNORE SETTINGS FILE (CONTAINS LOCAL MODEL PATHS AND CONFIGS)
API/UTILS/SETTINGS.py

# IGNORE ENVIRONMENT VARIABLE FILE FOR API
API/UTILS/.env

# IGNORE PYTHON BYTECODE FILES THAT ARE AUTOMATICALLY GENERATED
*.pyc
*.pyo
__pycache__/

# IGNORE IDE CONFIGURATION FILES
.vscode/    # VSCODE CONFIGURATION FOLDER
.idea/      # INTELLIJ IDEA CONFIGURATION FOLDER